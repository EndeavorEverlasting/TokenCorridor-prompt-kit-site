eItFor": "One concrete sprint should produce one coherent validated commit.", "doNotUseWhen": "The work contains several independent items; use P30.", "produces": "One tracked mutation, one commit, and focused validation.", "gate": "One owned mutation is committed and validated.", "then": "Use P11/P12 or another atomic lane.", "mutatesRepo": "Yes", "authority": "One tracked mutation and local GNHF commit", "proofCeiling": "One owned mutation is committed and validated.", "copySafeSheet": "P28_COPY_SAFE"}, {"seq": "29", "promptId": "P29", "moment": "GNHF Repo-First Mutation", "useItFor": "The repository is unfamiliar or stale but should move in the first run.", "doNotUseWhen": "The repo and exact mutation are already known; use P28.", "produces": "At most three candidates and the first safe mutation commit.", "gate": "First mutation occurs without repository-wide archaeology.", "then": "Use P28/P30 or P11/P12.", "mutatesRepo": "Yes", "authority": "Compact discovery followed by first tracked mutation", "proofCeiling": "First mutation occurs without repository-wide archaeology.", "copySafeSheet": "P29_COPY_SAFE"}, {"seq": "30", "promptId": "P30", "moment": "GNHF Finite Queue", "useItFor": "A small ordered backlog is already known.", "doNotUseWhen": "The queue is open-ended or larger than five active items.", "produces": "One coherent commit per item and final disposition ledger.", "gate": "Every supplied item is dispositioned and required proof passes.", "then": "Use P11/P12 or P27 after interruption.", "mutatesRepo": "Yes", "authority": "Tracked mutations limited to the supplied queue", "proofCeiling": "Every supplied item is dispositioned and required proof passes.", "copySafeSheet": "P30_COPY_SAFE"}, {"seq": "31", "promptId": "P31", "moment": "GNHF Commit Finalization Repair", "useItFor": "A worktree already contains an intended change that failed validation or commit finalization.", "doNotUseWhen": "No intended uncommitted change exists.", "produces": "The existing change is committed or preserved with an exact blocker.", "gate": "No new feature begins; existing work reaches a known commit state.", "then": "Use P11/P12 or P27.", "mutatesRepo": "Yes", "authority": "Existing diff repair and commit finalization only", "proofCeiling": "No new feature begins; existing work reaches a known commit state.", "copySafeSheet": "P31_COPY_SAFE"}, {"seq": "32", "promptId": "P32", "moment": "GNHF Validation and CI Repair", "useItFor": "A required test, validator, fixture, schema, or workflow is reproducibly failing.", "doNotUseWhen": "The work is a new feature rather than a reproducible required failure.", "produces": "Root-cause repair commits and executable regression proof.", "gate": "Required failures pass without suppression or downgrade.", "then": "Use P11/P12 or P36.", "mutatesRepo": "Yes", "authority": "Required validation, fixture, schema, test, and CI repair", "proofCeiling": "Required failures pass without suppression or downgrade.", "copySafeSheet": "P32_COPY_SAFE"}, {"seq": "33", "promptId": "P33", "moment": "GNHF Harness Hardening", "useItFor": "An offline harness needs deterministic parity, failure paths, or artifact integrity.", "doNotUseWhen": "The work requires live targets or real packages.", "produces": "Bounded harness commits and final PASS/SKIP/FAIL evidence.", "gate": "Zero unexplained required failures and contained evidence.", "then": "Use P11/P12; route live proof to P08.", "mutatesRepo": "Yes", "authority": "Offline harness, artifact, fixture, schema, and CI mutation", "proofCeiling": "Zero unexplained required failures and contained evidence.", "copySafeSheet": "P33_COPY_SAFE"}, {"seq": "34", "promptId": "P34", "moment": "GNHF Technician Experience", "useItFor": "Users should not need to recover commands from chat or guess the terminal.", "doNotUseWhen": "The user only needs immediate coaching rather than repo mutation.", "produces": "Launcher/help/docs/example commits and validated guidance.", "gate": "One clear implemented operator path remains.", "then": "Use P11/P12 and field acceptance.", "mutatesRepo": "Yes", "authority": "Launcher, help, docs, examples, and operator contracts", "proofCeiling": "One clear implemented operator path remains.", "copySafeSheet": "P34_COPY_SAFE"}, {"seq": "35", "promptId": "P35", "moment": "GNHF Dependency Maintenance", "useItFor": "One evidence-backed version or toolchain update is ready for bounded execution.", "doNotUseWhen": "The upgrade scope is broad, interactive, or unverified.", "produces": "Reproducible upgrade commits and compatibility proof.", "gate": "Only the named scope changes and checks pass.", "then": "Use P11/P12 or P36.", "mutatesRepo": "Yes", "authority": "Named dependency manifests, lockfiles, and compatibility repairs", "proofCeiling": "Only the named scope changes and checks pass.", "copySafeSheet": "P35_COPY_SAFE"}, {"seq": "36", "promptId": "P36", "moment": "GNHF PR Branch Repair", "useItFor": "An exact branch has review, CI, drift, regression, or scope defects.", "doNotUseWhen": "The exact branch or target base cannot be identified.", "produces": "Scoped local repair commits and a review-ready final diff.", "gate": "Exact-head repair queue is empty and local proof passes.", "then": "Human push/review, then P15 or P12.", "mutatesRepo": "Yes", "authority": "Exact PR-branch local repair; no remote mutation by default", "proofCeiling": "Exact-head repair queue is empty and local proof passes.", "copySafeSheet": "P36_COPY_SAFE"}, {"seq": "37", "promptId": "P37", "moment": "GNHF Agent Spawn Readiness Preflight", "useItFor": "A new agent, adapter, shell domain, or workstation must be proven before a long unattended run.", "doNotUseWhen": "The exact agent command has already passed a bounded child-process spawn test in the current shell.", "produces": "Spawnability result with exact path, timeout behavior, exit code, and next action.", "gate": "The command is spawnable without timeout and no command-presence-only claim is made.", "then": "Use P38 after PASS; fix the adapter or choose another proven agent after FAIL.", "mutatesRepo": "No", "authority": "Read-only shell and repository readiness authority", "proofCeiling": "Spawn and path proof only; no hosted inference or repository mutation proof.", "copySafeSheet": "P37_COPY_SAFE"}, {"seq": "38", "promptId": "P38", "moment": "GNHF Night Queue Compiler", "useItFor": "An issue-heavy repo needs a finite executable queue before an overnight repair run.", "doNotUseWhen": "A current committed queue already contains ready items with exact acceptance commands.", "produces": "Committed queue and baseline report with no more than five items.", "gate": "Every item is evidence-backed, owned, dependency-aware, and exactly testable.", "then": "Use P39, P40, or P41.", "mutatesRepo": "Yes", "authority": "Queue and report files only; no product-code repair", "proofCeiling": "Planning artifact commit only; no repair or runtime proof.", "copySafeSheet": "P38_COPY_SAFE"}, {"seq": "39", "promptId": "P39", "moment": "GNHF Overnight Repair Batch", "useItFor": "A committed queue contains ready local code repairs and the selected agent passed P37.", "doNotUseWhen": "The work is remote-only, open-ended, lacks exact validation, or requires live interaction.", "produces": "Up to three queue-item commits plus updated queue and night report.", "gate": "Every attempted item is committed or blocked with evidence; repeated no-progress stops the run.", "then": "Use P42, P43, or P44.", "mutatesRepo": "Yes", "authority": "Local code, tests, queue, and report within supplied scope", "proofCeiling": "Committed local repair proof only; no remote integration or live behavior claim.", "copySafeSheet": "P39_COPY_SAFE"}, {"seq": "40", "promptId": "P40", "moment": "GNHF Failure Cluster Repair", "useItFor": "One exact test or validator produces many related failures that can be clustered by root cause.", "doNotUseWhen": "Failures are unrelated or no exact reproducible command exists.", "produces": "One repaired cluster with regression proof or a committed diagnosis report.", "gate": "At most five related failures are handled without suppressing required checks.", "then": "Use P39 or P42.", "mutatesRepo": "Yes", "authority": "One bounded root-cause cluster", "proofCeiling": "Offline failure and regression proof; no broad backlog completion claim.", "copySafeSheet": "P40_COPY_SAFE"}, {"seq": "41", "promptId": "P41", "moment": "GNHF Stateful App / Game Safe Repair", "useItFor": "A stateful app or game needs code repairs but personal saves, accounts, resources, or production state must remain untouched.", "doNotUseWhen": "The requested proof requires unavoidable mutation of personal or non-disposable state.", "produces": "Up to three code-level repair commits and a runtime-proof handoff when needed.", "gate": "All work stays in code, tests, fixtures, or explicitly disposable runtime state.", "then": "Use P08 later for live proof; otherwise P42 or P44.", "mutatesRepo": "Yes", "authority": "Code, tests, deterministic fixtures, and safety report", "proofCeiling": "Code and deterministic test proof only unless disposable runtime proof is actually observed.", "copySafeSheet": "P41_COPY_SAFE"}, {"seq": "42", "promptId": "P42", "moment": "GNHF Night Queue Refill", "useItFor": "The current queue is exhausted, stale, or blocked and a new bounded set is needed.", "doNotUseWhen": "Ready items remain in the current queue.", "produces": "Refreshed committed queue preserving prior dispositions.", "gate": "No product code changes and no more than five new ready items.", "then": "Return to P39, P40, or P41.", "mutatesRepo": "Yes", "authority": "Queue and report refresh only", "proofCeiling": "Queue freshness proof only; no repair claim.", "copySafeSheet": "P42_COPY_SAFE"}, {"seq": "43", "promptId": "P43", "moment": "GNHF Night Run Recovery", "useItFor": "A preserved run stopped or made no progress and its exact state must be classified before retry.", "doNotUseWhen": "No preserved worktree or run evidence exists.", "produces": "Committed recovery report plus at most one continuation or finalization commit.", "gate": "No destructive cleanup or blind repetition of the original failure.", "then": "Resume with a proven agent or use P44.", "mutatesRepo": "Yes", "authority": "Exact preserved worktree and recovery artifacts", "proofCeiling": "Recovery and preserved-state proof; no claim beyond observed continuation.", "copySafeSheet": "P43_COPY_SAFE"}, {"seq": "44", "promptId": "P44", "moment": "GNHF Morning Closeout", "useItFor": "Overnight work must be reconciled, validated, and made reviewable.", "doNotUseWhen": "New feature implementation is still required.", "produces": "Committed closeout report, final validation matrix, clean worktree, and exact next command.", "gate": "All overnight commits and blockers are dispositioned; exit code alone is never success.", "then": "Human review, push, PR update, or next queue.", "mutatesRepo": "Yes", "authority": "Validation, report, and finalization of existing overnight work", "proofCeiling": "Closeout and local proof only; no push, merge, or release proof.", "copySafeSheet": "P44_COPY_SAFE"}, {"seq": "67", "promptId": "P67", "moment": "Repository Eval Framework Builder", "useItFor": "AI/agent behavior needs repository-wide quality and regression gates.", "doNotUseWhen": "Only one deterministic unit test is missing and no AI-behavior eval layer is needed.", "produces": "Versioned cases, oracles, reports, and executable eval gates.", "gate": "Representative regressions fail closed and deterministic checks precede expensive judge/model evaluation.", "then": "Use P68/P69 or the owning product repair based on what the eval exposes.", "mutatesRepo": "YES", "authority": "Eval fixtures, validators, reports, and CI inside owned scope", "proofCeiling": "Repository eval/static/synthetic proof; no live-user quality claim unless observed.", "copySafeSheet": "P67_COPY_SAFE"}, {"seq": "68", "p